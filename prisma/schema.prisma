generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  incomes             Income[]
  expenses            Expense[]
  moneyLents          MoneyLent[]
  moneyBorroweds      MoneyBorrowed[]
  investments         Investment[]
  passwordResetTokens PasswordResetToken[]
}

model Income {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  source    String
  date      DateTime
  note      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([date])
}

model Expense {
  id        String          @id @default(cuid())
  amount    Decimal         @db.Decimal(12, 2)
  category  ExpenseCategory
  date      DateTime
  note      String?
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
  @@index([date])
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  SHOPPING
  BILLS
  RENT
  HEALTH
  ENTERTAINMENT
  EDUCATION
  BUSINESS
  OTHER
}

model MoneyLent {
  id                 String      @id @default(cuid())
  personName         String
  amount             Decimal     @db.Decimal(12, 2)
  receivedAmount     Decimal     @default(0) @db.Decimal(12, 2)
  expectedReturnDate DateTime
  reason             String?
  status             LoanStatus  @default(PENDING)
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

enum LoanStatus {
  PENDING
  PARTIAL
  RECEIVED
}

model MoneyBorrowed {
  id                 String        @id @default(cuid())
  personName         String
  amount             Decimal       @db.Decimal(12, 2)
  borrowedDate       DateTime
  expectedReturnDate DateTime
  reason             String?
  status             BorrowStatus  @default(PENDING)
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

enum BorrowStatus {
  PENDING
  PAID
}

model Investment {
  id             String           @id @default(cuid())
  name           String
  amount         Decimal          @db.Decimal(12, 2)
  investmentDate DateTime
  status         InvestmentStatus @default(ACTIVE)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

enum InvestmentStatus {
  ACTIVE
  WITHDRAWN
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
