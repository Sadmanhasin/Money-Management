generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id @default(cuid())
  email      String      @unique
  password   String
  name       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  incomes    Income[]
  expenses   Expense[]
  moneyLents MoneyLent[]
}

model Income {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  source    String
  date      DateTime
  note      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([date])
}

model Expense {
  id        String          @id @default(cuid())
  amount    Decimal         @db.Decimal(12, 2)
  category  ExpenseCategory
  date      DateTime
  note      String?
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
  @@index([date])
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  SHOPPING
  BILLS
  RENT
  HEALTH
  ENTERTAINMENT
  EDUCATION
  BUSINESS
  OTHER
}

model MoneyLent {
  id                 String      @id @default(cuid())
  personName         String
  amount             Decimal     @db.Decimal(12, 2)
  expectedReturnDate DateTime
  reason             String?
  status             LoanStatus  @default(PENDING)
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

enum LoanStatus {
  PENDING
  RECEIVED
}
